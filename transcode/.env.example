# Copy to .env (gitignored) and edit. Offchain needs only the TRANSCODE_* vars.

# Max concurrent transcode jobs the runner advertises.
TRANSCODE_CAPACITY=4

# Encoder used per codec. CPU defaults work anywhere; the *_nvenc variants need
# the GPU overlay (docker-compose.gpu.yml, CUDA base + GPU reservation).
# VP8/VP9 have no GPU option in ffmpeg, so there's nothing to override for those.
TRANSCODE_AV1_ENCODER=libsvtav1
TRANSCODE_H264_ENCODER=libx264
TRANSCODE_H265_ENCODER=libx265

# --- On-chain (paid) only below; offchain ignores these. ---

NETWORK=arbitrum-one-mainnet
ETH_RPC_URL=https://arb1.arbitrum.io/rpc

# Orchestrator operating key (split-key): needs ETH for gas to redeem tickets.
ORCH_KEYSTORE_DIR=/absolute/path/to/operator-keystore
ORCH_ETH_ACCT=0xYourOperatorAddress
ORCH_ETH_PASSWORD=your-operator-keystore-password
# Registered orch = ticket recipient (-ethOrchAddr); empty = use the operating key.
ORCH_ONCHAIN_ADDR=0xYourRegisteredOrchestrator

# Pricing (on-chain): PRICE_PER_UNIT USD per PIXELS_PER_UNIT pixels. PRICE_PER_UNIT
# is an int (min 1); PIXELS_PER_UNIT scales the per-pixel price DOWN — ~1000 keeps
# a call under the 100-ticket cap.
PRICE_PER_UNIT=1
PIXELS_PER_UNIT=1000

# --- On-chain (paid) only below; offchain ignores these. ---

NETWORK=arbitrum-one-mainnet
ETH_RPC_URL=https://arb1.arbitrum.io/rpc

SIGNER_KEYSTORE_DIR=/absolute/path/to/signer-keystore
SIGNER_ETH_ACCT=0xYourSignerAddress
SIGNER_ETH_PASSWORD=your-signer-keystore-password

ORCH_KEYSTORE_DIR=/absolute/path/to/operator-keystore
ORCH_ETH_ACCT=0xYourOperatorAddress
ORCH_ETH_PASSWORD=your-operator-keystore-password
ORCH_ONCHAIN_ADDR=0xYourRegisteredOrchestrator

PIXELS_PER_UNIT=1000
MAX_PRICE_PER_UNIT=0.10USD
