# GPU variant of Dockerfile: same app, CUDA-enabled ffmpeg for *_nvenc encoders
# (av1_nvenc/h264_nvenc/hevc_nvenc) + NVDEC hwaccel. Requires an NVIDIA driver
# + nvidia-container-toolkit on the host and a GPU reservation in compose (see
# docker-compose.gpu.yml). Debian's ffmpeg (the CPU Dockerfile's base) has no
# nvenc support; Ubuntu's does, so this uses an nvidia/cuda Ubuntu base instead.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# ffmpeg = the batch engine (CLI) and what the SDK's live publisher shells out
# to; Ubuntu's package is built with --enable-nvenc, unlike Debian's.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ffmpeg python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# rs/media-publish-encoder-opts (livepeer-python-gateway#35): per-track bitrate +
# codec-aware encoder options, so the live path honors bitrate/profile + AV1/HEVC.
RUN pip install --no-cache-dir \
    "av" \
    "livepeer-gateway @ git+https://github.com/livepeer/livepeer-python-gateway@rs/media-publish-encoder-opts"

WORKDIR /app
COPY runner.py profiles.py engine.py ./

EXPOSE 8990

CMD ["python3", "runner.py"]
