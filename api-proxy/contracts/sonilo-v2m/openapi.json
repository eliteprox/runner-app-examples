      "category": "video-to-audio",
      "documentationUrl": "https://fal.ai/models/sonilo/v1.1/video-to-music/api",
      "endpointId": "sonilo/v1.1/video-to-music",
      "playgroundUrl": "https://fal.ai/models/sonilo/v1.1/video-to-music",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9c2fa5/jHE-xiu94lGuFQ6TRzyJ0_42eae911d4d0441e91d0e870274c4898.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/sonilo/v1.1/video-to-music": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V11VideoToMusicInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/sonilo/v1.1/video-to-music/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V11VideoToMusicOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/sonilo/v1.1/video-to-music/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/sonilo/v1.1/video-to-music/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
