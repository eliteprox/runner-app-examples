{
  "components": {
    "schemas": {
      "Audio": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "Audio",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "V11VideoToMusicInput": {
        "properties": {
          "duration": {
            "anyOf": [
              {
                "maximum": 600,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional. Length (seconds) of the video segment to score. When set, scores a segment of this length starting at Start Offset (or from the beginning if Start Offset is unset). Defaults (None) to the rest of the video: the whole video when Start Offset is unset, or from Start Offset to the end when it is set.",
            "title": "Duration"
          },
          "num_samples": {
            "default": 1,
            "description": "How many distinct music tracks to generate for the video.",
            "maximum": 3,
            "minimum": 1,
            "title": "Num Samples",
            "type": "integer"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional text prompt steering the musical style. If omitted, a prompt is generated automatically from the video.",
            "title": "Prompt"
          },
          "prompt_influence": {
            "default": 0.5,
            "description": "Turn it up to match the text prompt",
            "maximum": 1,
            "minimum": 0,
            "title": "Prompt Influence",
            "type": "number"
          },
          "start_offset": {
            "anyOf": [
              {
                "maximum": 600,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional. Start scoring from this offset (seconds) into the video. Requires Start Offset + Duration <= Video Duration.",
            "title": "Start Offset"
          },
          "video_url": {
            "description": "Public http(s) URL of the source video to score.",
            "examples": [
              "https://v3b.fal.media/files/b/0a9ddd00/2QssaYyFxstvVlmIraSns_Sonilo_Demo_Original_1.mp4"
            ],
            "title": "Video Url",
            "type": "string"
          }
        },
        "required": [
          "video_url"
        ],
        "title": "VideoToMusicInput",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "num_samples",
          "prompt",
          "prompt_influence",
          "start_offset",
          "duration"
        ]
      },
      "V11VideoToMusicOutput": {
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/Audio",
            "description": "The first generated music track, for quick preview/playback.",
            "examples": [
              {
                "content_type": "audio/mp4",
                "file_name": "Sonilo_Demo_Original_1_gen.m4a",
                "file_size": 1138270,
                "url": "https://v3b.fal.media/files/b/0a9ddd01/p5KXdY9tTYJH4f-ZQnZJ__Sonilo_Demo_Original_1_gen.m4a"
              }
            ]
          },
          "audios": {
            "description": "All generated music tracks (AAC/m4a), one per sample.",
            "examples": [
              [
                {
                  "content_type": "audio/mp4",
                  "file_name": "Sonilo_Demo_Original_1_gen.m4a",
                  "file_size": 1138270,
                  "url": "https://v3b.fal.media/files/b/0a9ddd01/p5KXdY9tTYJH4f-ZQnZJ__Sonilo_Demo_Original_1_gen.m4a"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Audio"
            },
            "title": "Audios",
            "type": "array"
          }
        },
        "required": [
          "audio",
          "audios"
        ],
        "title": "VideoToMusicOutput",
        "type": "object",
        "x-fal-order-properties": [
          "audio",
          "audios"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the sonilo/v1.1/video-to-music queue.",
    "title": "Queue OpenAPI for sonilo/v1.1/video-to-music",
