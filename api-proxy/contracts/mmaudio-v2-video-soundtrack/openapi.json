{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "MmaudioV2Input": {
        "properties": {
          "cfg_strength": {
            "default": 4.5,
            "description": "The strength of Classifier Free Guidance.",
            "maximum": 20,
            "minimum": 0,
            "title": "Cfg Strength",
            "type": "number"
          },
          "duration": {
            "default": 8,
            "description": "The duration of the audio to generate.",
            "maximum": 30,
            "minimum": 1,
            "title": "Duration",
            "type": "number"
          },
          "mask_away_clip": {
            "default": false,
            "description": "Whether to mask away the clip.",
            "title": "Mask Away Clip",
            "type": "boolean"
          },
          "negative_prompt": {
            "default": "",
            "description": "The negative prompt to generate the audio for.",
            "title": "Negative Prompt",
            "type": "string"
          },
          "num_steps": {
            "default": 25,
            "description": "The number of steps to generate the audio for.",
            "maximum": 50,
            "minimum": 4,
            "title": "Num Steps",
            "type": "integer"
          },
          "prompt": {
            "description": "The prompt to generate the audio for.",
            "examples": [
              "Indian holy music"
            ],
            "title": "Prompt",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The seed for the random number generator",
            "title": "Seed"
          },
          "video_url": {
            "description": "The URL of the video to generate the audio for.",
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/video_models/mmaudio_input.mp4"
            ],
            "title": "Video Url",
            "type": "string"
          }
        },
        "required": [
          "video_url",
          "prompt"
        ],
        "title": "BaseInput",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "prompt",
          "negative_prompt",
          "seed",
          "num_steps",
          "duration",
          "cfg_strength",
          "mask_away_clip"
        ]
      },
      "MmaudioV2Output": {
        "properties": {
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video with the lip sync.",
            "examples": [
              {
                "content_type": "application/octet-stream",
                "file_name": "mmaudio_input.mp4",
                "file_size": 1001342,
                "url": "https://storage.googleapis.com/falserverless/model_tests/video_models/mmaudio_output.mp4"
              }
            ]
          }
        },
        "required": [
          "video"
        ],
        "title": "Output",
        "type": "object",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the fal-ai/mmaudio-v2 queue.",
    "title": "Queue OpenAPI for fal-ai/mmaudio-v2",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Video To Video",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/mmaudio-v2/api",
      "endpointId": "fal-ai/mmaudio-v2",
      "playgroundUrl": "https://fal.ai/models/fal-ai/mmaudio-v2",
      "thumbnailUrl": "https://storage.googleapis.com/falserverless/gallery/mmaudio-v2.webp"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/mmaudio-v2": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MmaudioV2Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/mmaudio-v2/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MmaudioV2Output"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/mmaudio-v2/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/mmaudio-v2/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
