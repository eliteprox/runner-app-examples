{
  "components": {
    "schemas": {
      "GrokImagineImageV20TextToImageInput": {
        "properties": {
          "aspect_ratio": {
            "default": "1:1",
            "description": "Aspect ratio of the generated image.",
            "enum": [
              "2:1",
              "20:9",
              "19.5:9",
              "16:9",
              "4:3",
              "3:2",
              "1:1",
              "2:3",
              "3:4",
              "9:16",
              "9:19.5",
              "9:20",
              "1:2"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "num_images": {
            "default": 1,
            "description": "Number of images to generate.",
            "maximum": 4,
            "minimum": 1,
            "title": "Number of Images",
            "type": "integer"
          },
          "output_format": {
            "default": "jpeg",
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "title": "Output Format",
            "type": "string"
          },
          "prompt": {
            "description": "Text description of the desired image.",
            "examples": [
              "Abstract human silhouette, golden particles ready to burst outward representing joy, data visualization style, emotional expression through particles, artistic scientific"
            ],
            "maxLength": 8000,
            "title": "Prompt",
            "type": "string"
          },
          "quality": {
            "default": "medium",
            "description": "Quality level of the generated image.",
            "enum": [
              "low",
              "medium"
            ],
            "title": "Quality",
            "type": "string"
          },
          "resolution": {
            "default": "1k",
            "description": "Resolution of the generated image. `1k` for standard resolution, `2k` for high resolution.",
            "enum": [
              "1k",
              "2k"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "sync_mode": {
            "default": false,
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "type": "boolean"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "XAIImageV2Input",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "num_images",
          "aspect_ratio",
          "resolution",
          "output_format",
          "sync_mode",
          "quality"
        ]
      },
      "GrokImagineImageV20TextToImageOutput": {
        "properties": {
          "images": {
            "description": "The URL of the generated image.",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8b90b7/9avg_nKJmcVinjQHJR_Ja.jpg"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images",
            "type": "array"
          },
          "revised_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The enhanced prompt that was used to generate the image.",
            "title": "Revised Prompt"
          }
        },
        "required": [
          "images"
        ],
        "title": "XAIImageOutput",
        "type": "object",
        "x-fal-order-properties": [
          "images",
          "revised_prompt"
        ]
      },
      "ImageFile": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image",
            "title": "Height"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image",
            "title": "Width"
          }
        },
        "required": [
          "url"
        ],
        "title": "ImageFile",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the xai/grok-imagine-image/v2.0/text-to-image queue.",
