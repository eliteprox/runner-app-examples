                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/xai/grok-imagine-image/v2.0/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
