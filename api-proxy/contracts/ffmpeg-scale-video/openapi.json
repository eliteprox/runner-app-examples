{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "WorkflowUtilitiesScaleVideoInput": {
        "description": "Input model for scaling/resizing a video to specific dimensions",
        "properties": {
          "codec": {
            "default": "libx264",
            "description": "Video codec to use for encoding. libx264 (H.264) is widely compatible, libx265 (H.265/HEVC) offers better compression.",
            "enum": [
              "libx264",
              "libx265"
            ],
            "title": "Codec",
            "type": "string"
          },
          "crf": {
            "default": 18,
            "description": "Constant Rate Factor for quality (0-51). Lower values mean better quality and larger files. 18 is visually lossless for most content.",
            "maximum": 51,
            "minimum": 0,
            "title": "Crf",
            "type": "integer"
          },
          "height": {
            "anyOf": [
              {
                "maximum": 4320,
                "minimum": 2,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Target height in pixels. If only height is provided, width is auto-calculated to preserve aspect ratio. At least one of width or height must be provided.",
            "examples": [
              1080,
              2160,
              720
            ],
            "title": "Height"
          },
          "mode": {
            "default": "stretch",
            "description": "Scaling mode. 'stretch' scales the video to the exact target dimensions (may distort aspect ratio). 'pad' scales to fit within the target dimensions while preserving aspect ratio, then pads with the chosen color to fill the remaining space (letterbox/pillarbox). 'crop' scales to cover the target dimensions while preserving aspect ratio, then center-crops to the exact target size.",
            "enum": [
              "stretch",
              "pad",
              "crop"
            ],
            "title": "Mode",
            "type": "string"
          },
          "pad_color": {
            "default": "black",
            "description": "Padding color when mode is 'pad'. Ignored for other modes.",
            "enum": [
              "black",
              "white",
              "red",
              "green",
              "blue",
              "gray"
            ],
            "title": "Pad Color",
            "type": "string"
          },
          "preset": {
            "default": "fast",
            "description": "Encoding speed preset. Slower presets give better compression but take longer.",
            "enum": [
              "ultrafast",
              "fast",
              "medium",
              "slow"
            ],
            "title": "Preset",
            "type": "string"
          },
          "video_url": {
            "description": "URL of the video file to scale/resize. Height and Width of the video must be even numbers for compatibility with video codecs.",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_outputs/wan-25-i2v-output.mp4"
            ],
            "max_file_size": 500000000,
            "title": "Video Url",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "maximum": 7680,
                "minimum": 2,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Target width in pixels. If only width is provided, height is auto-calculated to preserve aspect ratio. At least one of width or height must be provided.",
            "examples": [
              1920,
              3840,
              1280
            ],
            "title": "Width"
          }
        },
        "required": [
          "video_url"
        ],
        "title": "ScaleVideoInput",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "width",
          "height",
          "mode",
          "pad_color",
          "codec",
          "preset",
          "crf"
        ]
      },
      "WorkflowUtilitiesScaleVideoOutput": {
        "description": "Output model for scaled/resized video",
        "properties": {
          "original_height": {
            "description": "Height of the original video in pixels",
            "examples": [
              1082
            ],
            "title": "Original Height",
            "type": "integer"
          },
          "original_width": {
            "description": "Width of the original video in pixels",
            "examples": [
              1929
            ],
            "title": "Original Width",
            "type": "integer"
          },
          "scaled_height": {
            "description": "Height of the output video in pixels",
            "examples": [
              1080
            ],
            "title": "Scaled Height",
            "type": "integer"
          },
          "scaled_width": {
            "description": "Width of the output video in pixels",
            "examples": [
              1920
            ],
            "title": "Scaled Width",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The scaled/resized video",
            "examples": [
              {
                "content_type": "video/mp4",
                "file_name": "output.mp4",
                "file_size": 3456789,
                "url": "https://v3b.fal.media/files/b/monkey/scaled_output.mp4"
              }
            ]
          }
        },
        "required": [
          "video",
          "original_width",
          "original_height",
          "scaled_width",
          "scaled_height"
        ],
        "title": "ScaleVideoOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "original_width",
          "original_height",
          "scaled_width",
          "scaled_height"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the fal-ai/workflow-utilities/scale-video queue.",
    "title": "Queue OpenAPI for fal-ai/workflow-utilities/scale-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Scale/resize a video to specific dimensions.\n\nThree modes are available:\n- stretch: Scale to exact dimensions (may distort aspect ratio)\n- pad: Scale to fit within dimensions preserving aspect ratio, pad remaining space\n- crop: Scale to cover dimensions preserving aspect ratio, center-crop to fit",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/workflow-utilities/scale-video/api",
      "endpointId": "fal-ai/workflow-utilities/scale-video",
      "playgroundUrl": "https://fal.ai/models/fal-ai/workflow-utilities/scale-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8eb99a/kyzJ7WEk8DJzfmZelPiHR_330f8652ee854c3c8b1323e6d2f6fe86.png"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/workflow-utilities/scale-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowUtilitiesScaleVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/workflow-utilities/scale-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowUtilitiesScaleVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/workflow-utilities/scale-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/workflow-utilities/scale-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
