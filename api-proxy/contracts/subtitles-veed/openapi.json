    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "PresetCustomization": {
        "additionalProperties": false,
        "description": "Runtime customization of a preset. Fields are Optional all the way down\nso this block can sit under the playground's 'Additional Settings' section\nwithout flagging required-field asterisks the user didn't ask for.",
        "properties": {
          "position": {
            "anyOf": [
              {
                "enum": [
                  "top",
                  "center",
                  "bottom"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Vertical placement of static subtitles on screen.",
            "title": "Position"
          },
          "shadow": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "min",
                  "mid",
                  "max"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Improves readability over bright or busy backgrounds.",
            "title": "Shadow"
          },
          "text_customizations": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextCustomizations"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-tier text styling for baseline and highlighted words.",
            "title": "Text customizations"
          }
        },
        "title": "PresetCustomization",
        "type": "object",
        "x-fal-order-properties": [
          "position",
          "shadow",
          "text_customizations"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
