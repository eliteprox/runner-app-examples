  "info": {
    "description": "The OpenAPI schema for the veed/subtitles queue.",
    "title": "Queue OpenAPI for veed/subtitles",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Render",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/veed/subtitles/api",
      "endpointId": "veed/subtitles",
      "playgroundUrl": "https://fal.ai/models/veed/subtitles",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9abb98/lM8WGbJkKyFl5iABMR-3q_3192a25aba5c4ec7895cc8f2ac48f841.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/veed/subtitles": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubtitlesInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/veed/subtitles/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubtitlesOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/veed/subtitles/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/veed/subtitles/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
