      "TextCustomization": {
        "additionalProperties": false,
        "description": "Per-tier text overrides. No italic field (preset-dictated, see ENR-2516).",
        "properties": {
          "color": {
            "anyOf": [
              {
                "pattern": "^#([0-9A-Fa-f]{3}){1,2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override the text color for this tier.",
            "title": "Color"
          },
          "font": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override the font used for this text tier. Must be a supported Google Font \u2014 see https://www.veed.io/api/v1/subtitle-renders/fonts for the canonical list. Unrecognized fonts are rejected with a 400.",
            "title": "Font"
          },
          "weight": {
            "anyOf": [
              {
                "maximum": 900,
                "minimum": 100,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Font weight 100-900. Values >= 700 render as bold",
            "title": "Weight"
          }
        },
        "title": "TextCustomization",
        "type": "object",
        "x-fal-order-properties": [
          "font",
          "weight",
          "color"
        ]
      },
      "TextCustomizations": {
        "additionalProperties": false,
        "description": "Text customization keyed by word-importance tier.",
        "properties": {
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextCustomization"
              },
              {
                "type": "null"
              }
            ],
            "description": "Baseline styling applied to every word in the transcript. This is what a reader sees by default, before any per-word emphasis is applied.",
            "title": "Baseline (all words)"
          },
          "highlighted": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextCustomization"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mid-rank words (automatically marked as noteworthy: key nouns, action verbs, salient adjectives). Presets typically bump size or weight on these.",
            "title": "Highlighted (mid-rank)"
          }
        },
        "title": "TextCustomizations",
        "type": "object",
        "x-fal-order-properties": [
          "baseline",
          "highlighted"
        ]
      },
      "VocabularyEntry": {
        "additionalProperties": false,
        "description": "A term auto-transcription should recognise correctly, plus its common misspellings.",
        "properties": {
          "replaces": {
            "description": "Misspellings that should be replaced with `word`. Matched whole-word and case-insensitively \u2014 list each misspelling once; you don't need to enumerate casings (e.g. `['vid']` already covers `Vid`, `VID`).",
            "examples": [
              [
                "vid",
                "feed"
              ]
            ],
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Replaces",
            "type": "array"
          },
          "word": {
            "description": "The correctly-spelled term. Brand names, product names, and domain jargon work best.",
            "examples": [
              "VEED",
              "TikTok"
            ],
            "maxLength": 100,
            "minLength": 1,
            "title": "Word",
            "type": "string"
          }
        },
        "required": [
          "word",
          "replaces"
        ],
        "title": "VocabularyEntry",
        "type": "object",
        "x-fal-order-properties": [
          "word",
          "replaces"
        ]
      }
    },
