{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "VoidVideoInpaintingInput": {
        "properties": {
          "enable_pass2_refinement": {
            "default": false,
            "description": "Run VOID Pass 2 warped-noise refinement after Pass 1. This is slower but can improve temporal consistency on longer clips.",
            "title": "Enable Pass2 Refinement",
            "type": "boolean"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Enable content safety checking on the output.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "guidance_scale": {
            "default": 1,
            "description": "Classifier-free guidance scale.",
            "maximum": 20,
            "minimum": 0,
            "title": "Guidance Scale",
            "type": "number"
          },
          "mask_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Text description of what should be masked in the input video, such as the object or person to remove. Used to generate a temporary mask video with SAM-3 when `quad_mask_video_url` is not provided.",
            "examples": [
              "the person walking through the hallway"
            ],
            "title": "Mask Prompt"
          },
          "negative_prompt": {
            "default": "The video is not of a high quality, it has a low resolution. Watermark present in each frame. The background is solid. Strange body and strange trajectory. Distortion.",
            "description": "Negative prompt to guide generation away from undesired outputs.",
            "title": "Negative Prompt",
            "type": "string"
          },
          "num_frames": {
            "default": 85,
            "description": "Temporal window size for inference. The backend snaps this to the nearest CogVideoX-safe value that works with temporal compression and patching. Valid outputs are 69, 77, 85, ..., 197.",
            "maximum": 197,
            "minimum": 1,
            "title": "Num Frames",
            "type": "integer"
          },
          "num_inference_steps": {
            "default": 30,
            "description": "Number of denoising steps. Higher values improve quality but increase latency.",
            "maximum": 50,
            "minimum": 1,
            "title": "Num Inference Steps",
            "type": "integer"
          },
          "prompt": {
            "description": "Text description of the desired background after object removal.",
            "examples": [
              "a video of buildings reflecting on a calm river"
            ],
            "title": "Prompt",
            "type": "string"
          },
          "quad_mask_video_url": {
            "default": "",
            "description": "URL of a mask video for the removal target. For best results this should be a VOID-style quadmask video with 4 grayscale values: 0=object to remove, 63=overlap, 127=affected region, 255=background to keep. A simple binary mask (0=remove, 255=keep) also works. If omitted, the app will generate a temporary mask video from `mask_prompt` using the SAM-3 video endpoint and convert it to a quadmask automatically.",
            "examples": [
              "https://storage.googleapis.com/falserverless/kontext-blog/trimask_quadmask.mp4"
            ],
            "title": "Quad Mask Video Url",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducibility.",
            "title": "Seed"
          },
          "strength": {
            "default": 1,
            "description": "Denoising strength. 1.0 means full denoising.",
            "maximum": 1,
            "minimum": 0,
            "title": "Strength",
            "type": "number"
          },
          "video_url": {
            "description": "URL of the input video containing the object to remove.",
            "examples": [
              "https://storage.googleapis.com/falserverless/kontext-blog/input_video.mp4"
            ],
            "title": "Video Url",
            "type": "string"
          }
        },
        "required": [
          "video_url",
          "prompt"
        ],
        "title": "Input",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "quad_mask_video_url",
          "mask_prompt",
          "prompt",
          "enable_pass2_refinement",
          "negative_prompt",
          "num_inference_steps",
          "guidance_scale",
          "strength",
          "seed",
          "num_frames",
          "enable_safety_checker"
        ]
      },
      "VoidVideoInpaintingOutput": {
        "properties": {
          "seed": {
            "description": "The seed used for generation.",
            "title": "Seed",
            "type": "integer"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Timing breakdown for pipeline stages.",
            "title": "Timings",
            "type": "object"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The output video with the object removed.",
            "examples": [
              {
                "url": "https://v3b.fal.media/files/b/0a95b6f4/D89J5QV-wztq3B0OI44Sl_tmpl1cf522v.mp4"
              }
            ]
          }
        },
        "required": [
          "video",
          "seed",
          "timings"
        ],
        "title": "Output",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed",
          "timings"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the fal-ai/void-video-inpainting queue.",
    "title": "Queue OpenAPI for fal-ai/void-video-inpainting",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Generate",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/void-video-inpainting/api",
      "endpointId": "fal-ai/void-video-inpainting",
      "playgroundUrl": "https://fal.ai/models/fal-ai/void-video-inpainting",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a959ab1/J4yvJNbWY73Ca0TwDrlhE_e14266cf79374705aabff60c8ee7ac50.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/void-video-inpainting": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidVideoInpaintingInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/void-video-inpainting/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoidVideoInpaintingOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/void-video-inpainting/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/void-video-inpainting/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
