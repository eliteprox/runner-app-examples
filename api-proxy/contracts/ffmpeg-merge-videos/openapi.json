{
  "components": {
    "schemas": {
      "FfmpegApiMergeVideosInput": {
        "properties": {
          "resolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Resolution of the final video. Width and height must be between 512 and 2048.",
            "title": "Resolution"
          },
          "resolution_aspect_ratio_video_index": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Zero-based index of the input video whose aspect ratio should be used when resolution is not provided. If omitted, preserves the default behavior of using the minimum width and minimum height across input videos.",
            "title": "Resolution Aspect Ratio Video Index"
          },
          "target_fps": {
            "anyOf": [
              {
                "maximum": 60,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Target FPS for the output video. If not provided, uses the lowest FPS from input videos.",
            "title": "Target Fps"
          },
          "video_urls": {
            "description": "List of video URLs to merge in order",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "title": "Video Urls",
            "type": "array"
          }
        },
        "required": [
          "video_urls"
        ],
        "title": "MergeVideosInput",
        "type": "object",
        "x-fal-order-properties": [
          "video_urls",
          "target_fps",
          "resolution",
          "resolution_aspect_ratio_video_index"
        ]
      },
      "FfmpegApiMergeVideosOutput": {
        "properties": {
          "metadata": {
            "description": "Metadata about the merged video including original video info",
            "title": "Metadata",
            "type": "object"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "Merged video file"
          }
        },
        "required": [
          "video",
          "metadata"
        ],
        "title": "MergeVideosOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "metadata"
        ]
      },
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "ImageSize": {
        "properties": {
          "height": {
            "default": 512,
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "default": 512,
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "title": "Width",
            "type": "integer"
          }
        },
        "title": "ImageSize",
        "type": "object",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
