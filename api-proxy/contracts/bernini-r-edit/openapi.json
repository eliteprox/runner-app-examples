{
  "components": {
    "schemas": {
      "BerniniREditVideoInput": {
        "properties": {
          "acceleration": {
            "default": "none",
            "description": "Acceleration level. 'regular' enables MagCache step-skipping for faster generation at a small quality cost; 'none' (default) runs the full denoising schedule.",
            "enum": [
              "none",
              "regular"
            ],
            "title": "Acceleration",
            "type": "string"
          },
          "enable_prompt_expansion": {
            "default": false,
            "description": "Rewrite the prompt with an LLM before generation. The model is tuned on enhanced prompts; off by default.",
            "title": "Enable Prompt Expansion",
            "type": "boolean"
          },
          "frames_per_second": {
            "default": 16,
            "description": "Output frames per second.",
            "maximum": 30,
            "minimum": 4,
            "title": "Frames Per Second",
            "type": "integer"
          },
          "max_image_size": {
            "default": 848,
            "description": "Long-edge size (px). Sets the output size for generation tasks and caps source/reference media for editing tasks.",
            "maximum": 1280,
            "minimum": 256,
            "title": "Max Image Size",
            "type": "integer"
          },
          "negative_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Negative prompt. Defaults to the standard Wan2.2 negative prompt.",
            "title": "Negative Prompt"
          },
          "num_frames": {
            "default": 81,
            "description": "Number of frames. Snapped internally to 4k+1.",
            "maximum": 121,
            "minimum": 5,
            "title": "Num Frames",
            "type": "integer"
          },
          "num_inference_steps": {
            "default": 30,
            "description": "Number of denoising steps.",
            "maximum": 50,
            "minimum": 1,
            "title": "Num Inference Steps",
            "type": "integer"
          },
          "prompt": {
            "description": "Text prompt or editing instruction.",
            "examples": [
              "A cute corgi leaping in a sunny park, Van Gogh oil-painting style."
            ],
            "title": "Prompt",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seed for reproducibility. Random when omitted.",
            "title": "Seed"
          },
          "video_url": {
            "description": "Source video to edit.",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/seedance_pro_i2v.mp4"
            ],
            "title": "Video Url",
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "video_url"
        ],
        "title": "EditVideoInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "negative_prompt",
          "num_inference_steps",
          "max_image_size",
          "seed",
          "enable_prompt_expansion",
          "num_frames",
          "frames_per_second",
          "acceleration",
          "video_url"
        ]
      },
      "BerniniREditVideoOutput": {
        "properties": {
          "actual_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The final prompt after expansion (set only when prompt expansion ran).",
            "title": "Actual Prompt"
          },
          "seed": {
            "description": "Seed used for generation.",
            "title": "Seed",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "Generated / edited video."
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "VideoOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed",
          "actual_prompt"
        ]
      },
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Bernini R edits an existing video from a simple instruction. Remove or add objects, change the weather, background, camera angle, or art style, adjust a character's expression or how subjects interact, even reason about time, all while keeping the rest of the scene unchanged. Built on ByteDance's unified generate-and-edit model, ranked first-tier among leading commercial video editors.",
    "title": "Queue OpenAPI for fal-ai/bernini-r/edit-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Edit Video",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/bernini-r/edit-video/api",
      "endpointId": "fal-ai/bernini-r/edit-video",
      "playgroundUrl": "https://fal.ai/models/fal-ai/bernini-r/edit-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9d8156/Id_OtIbUS5Zk9ivk4tOuI_9416b514fc6b4de7ae727285aec5bacf.jpg"
    }
  },
