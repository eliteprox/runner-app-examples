                "x-fal": {
                  "max_duration": 10.05,
                  "max_file_size": 209715200,
                  "max_fps": 60,
                  "max_height": 2160,
                  "max_width": 2160,
                  "min_duration": 3,
                  "min_fps": 24,
                  "min_height": 720,
                  "min_width": 720,
                  "timeout": 30
                }
              },
              {
                "type": "null"
              }
