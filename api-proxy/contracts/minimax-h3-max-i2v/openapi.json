{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "H3MaxImageToVideoInput": {
        "properties": {
          "duration": {
            "default": 5,
            "description": "The duration of the video in seconds.",
            "maximum": 15,
            "minimum": 5,
            "title": "Duration",
            "type": "integer"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, the safety checker will be enabled.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "end_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional URL of the image to use as the last frame, for first-to-last keyframe generation.",
            "title": "End Image URL"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional URL of the image to use as the first frame. When provided, the output aspect ratio follows this image. When omitted, the request is handled as text-to-video (16:9 by default).",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/hailuo23/pro_i2v_in.jpg"
            ],
            "title": "Image URL"
          },
          "prompt": {
            "description": "Text prompt for video generation",
            "examples": [
              "The camera slowly pulls back from the scene, revealing the full landscape as clouds drift overhead and light shifts across the terrain."
            ],
            "maxLength": 50000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "prompt_expansion_mode": {
            "default": "balanced",
            "description": "How much effort to spend rewriting the prompt before generation. 'balanced' returns in about a second. 'quality' spends up to ~30s on a richer prompt.",
            "examples": [
              "balanced",
              "quality"
            ],
            "title": "Prompt Expansion Mode",
            "type": "string"
          },
          "resolution": {
            "default": "768P",
            "description": "The native generation resolution of the video.",
            "enum": [
              "480P",
              "768P"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed. A random seed is selected when omitted.",
            "title": "Seed"
          },
          "sync_mode": {
            "default": false,
            "description": "Return the generated video as base64 instead of a CDN URL.",
            "title": "Sync Mode",
            "type": "boolean"
          }
        },
        "required": [
          "prompt",
          "prompt_expansion_mode"
        ],
        "title": "TurboImageToVideoHailuo03Input",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "duration",
          "resolution",
          "seed",
          "enable_safety_checker",
          "sync_mode",
          "prompt_expansion_mode",
          "image_url",
          "end_image_url"
        ]
      },
      "H3MaxImageToVideoOutput": {
        "properties": {
          "expanded_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The prompt after expansion, as sent to the model. Null when prompt expansion was disabled, left the prompt unchanged, or was performed internally by MiniMax's hosted API.",
            "title": "Expanded Prompt"
          },
          "timings": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timing breakdown in seconds. 'inference' is the DiT denoising time on the GPU backend. Null on routes that do not report backend timings.",
            "title": "Timings"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video"
          }
        },
        "required": [
          "video"
        ],
        "title": "TurboImageToVideoHailuo03Output",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "expanded_prompt",
          "timings"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the minimax/h3-max/image-to-video queue.",
    "title": "Queue OpenAPI for minimax/h3-max/image-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Image-text-to-video: ``image_url`` optional; text-only routes to t2v.",
      "category": "image-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max/image-to-video/api",
      "endpointId": "minimax/h3-max/image-to-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max/image-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa7658f/fSQlWMcduHn4_abgJ7qhQ.jpg"
    }
  },
  "openapi": "3.0.4",
  "paths": {
    "/minimax/h3-max/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/H3MaxImageToVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/minimax/h3-max/image-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/H3MaxImageToVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/minimax/h3-max/image-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/minimax/h3-max/image-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
